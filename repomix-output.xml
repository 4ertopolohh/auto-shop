name: auto-shop
services:
  db:
    image: postgres:16-alpine
    env_file: .env
    volumes:
      - postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 5s
      timeout: 5s
      retries: 20
    restart: unless-stopped
  backend:
    build: .
    env_file: .env
    volumes:
      - ./data:/data
    depends_on:
      db:
        condition: service_healthy
    restart: unless-stopped
  web:
    networks:
      - default
      - ingress
    image: nginx:1.28-alpine
    ports:
      - "127.0.0.1:18100:80"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - ./frontend:/usr/share/nginx/html:ro
      - ./data/static:/static:ro
      - ./data/media:/media:ro
    depends_on:
      - backend
    restart: unless-stopped
volumes:
  postgres:

networks:
  ingress: {}
  default:
    internal: true
