    name: "Двигатель",
    text: "Силовой блок, впуск и система охлаждения. Посмотрите, как всё связано под капотом.",
  },
  {
    id: "brakes",
    name: "Тормозная система",
    text: "Диски и суппорты остаются на своих местах, когда колёса отходят в стороны.",
  },
  {
    id: "suspension",
    name: "Подвеска",
    text: "Колёса, стойки и несущая платформа. Основа уверенного движения.",
  },
  {
    id: "filters",
    name: "Фильтры",
    text: "Воздушный тракт двигателя и пространство салона — найдите свой расходный элемент.",
  },
];
export default function VehicleExplorer() {
  const [active, setActive] = useState("engine"),
    [pinned, setPinned] = useState(false),
    [hovered, setHovered] = useState(false),
    [visible, setVisible] = useState(false);
  const [phase, setPhase] = useState<"loading" | "ready" | "error">("loading");
  const host = useRef<HTMLElement>(null);
  const select = useCallback((category: string) => {
    if (parts.some((p) => p.id === category)) setActive(category);
  }, []);
  useEffect(() => {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          setVisible(true);
          observer.disconnect();
        }
      },
      { rootMargin: "220px" },
    );
    if (host.current) observer.observe(host.current);
    return () => observer.disconnect();
  }, []);
  const toggle = useCallback(() => setPinned((value) => !value), []);
  const part = parts.find((p) => p.id === active)!;
  return (
    <section
      className={s.explorer}
      ref={host}
      aria-label="Интерактивный автомобиль"
    >
      <div className={s.copy}>
        <h2>
          В каждой детали —<br />
          <span>целый автомобиль.</span>
        </h2>
        <p>
          Вращайте автомобиль, чтобы рассмотреть его со всех сторон. Наведите
          курсор на кузов — и он плавно разберётся на слои.
        </p>
        <div className={s.parts} aria-label="Узлы автомобиля">
          {parts.map((p) => (
            <button
              key={p.id}
              aria-pressed={active === p.id}
              onClick={() => setActive(p.id)}
            >
              {p.name}
            </button>
          ))}
        </div>
        <div className={s.partInfo} key={active}>
          <h3>{part.name}</h3>
          <p>{part.text}</p>
          <Link to={`/catalog?category=${part.id}`}>Перейти к деталям</Link>
        </div>
      </div>
      <div className={s.presentation}>
        <div
          className={s.stage}
          data-phase={phase}
          data-expanded={pinned || hovered}
        >
          {visible && (
            <Suspense fallback={null}>
              <CarScene
                pinned={pinned}
                onHovered={setHovered}
                onPhase={setPhase}
                onSelect={select}
                onToggle={toggle}
              />
            </Suspense>
          )}
          {phase === "loading" && (
            <div className={s.loading} role="status">
              <div />
              <span>Подготавливаем автомобиль</span>
            </div>
          )}
          {phase === "error" && (
            <div className={s.fallback}>
              <img
                src="/models/sedan-poster.png"
                alt="Чёрный автомобиль без логотипов — вид спереди и сбоку"
                loading="lazy"
              />
              <p>
                В этом браузере 3D недоступно. Откройте сайт в браузере с
                поддержкой WebGL.
              </p>
            </div>
          )}
        </div>
        <p className={s.hint}>
          Перетаскивание — вращение. На телефоне используйте касание автомобиля
          для разборки.
        </p>
      </div>
    </section>
  );
}
</file>

<file path="frontend/src/pages/Cart.tsx">
import { Link } from "react-router-dom";
import { Truck } from "lucide-react";
import { useCart } from "../store";
import { money } from "../api";
import { Empty, Image } from "../components/UI";
import s from "./Commerce.module.scss";
export default function Cart() {
  const { items, count, total, change } = useCart();
  return (
    <div className="container">
      <div className="breadcrumb">
        <Link to="/">Главная</Link>
        <span>Корзина</span>
      </div>
      <h1 className="pageTitle">
        Ваши детали<span className={s.count}>{count}</span>
      </h1>
      <p className={s.subtitle}>Всё нужное для следующего километра.</p>
      {!items.length ? (
        <Empty title="Здесь пока тихо">
          <p>Найдите нужные запчасти — мы соберём их здесь.</p>
          <Link className="button" to="/catalog">
            Перейти в каталог
          </Link>
        </Empty>
      ) : (
        <div className={s.layout}>
          <div className={s.cartItems}>
            {items.map(({ product: p, quantity }) => (
              <article className={s.cartItem} key={p.id}>
                <Link to={`/product/${p.slug}`} className={s.cartImage}>
                  <Image src={p.images[0]?.url} alt={p.name} />
                </Link>
                <div className={s.itemInfo}>
                  <span>
                    {p.brand} / {p.sku}
                  </span>
                  <Link to={`/product/${p.slug}`}>{p.name}</Link>
                  <p>В наличии · {money(p.price)} за шт.</p>
                </div>
                <div className={s.quantity}>
                  <button
                    onClick={() => change(p.id, quantity - 1)}
                    aria-label={`Уменьшить ${p.name}`}
                  >
                    Убавить
                  </button>
                  <span>{quantity}</span>
                  <button
                    disabled={quantity >= Math.min(p.stock, 99)}
                    onClick={() => change(p.id, quantity + 1)}
                    aria-label={`Увеличить ${p.name}`}
                  >
                    Добавить
                  </button>
                </div>
                <strong>{money(Number(p.price) * quantity)}</strong>
                <button
                  className={s.remove}
                  onClick={() => change(p.id, 0)}
                  aria-label={`Удалить ${p.name}`}
                >
                  Удалить
                </button>
              </article>
            ))}
            <Link to="/catalog" className={s.back}>
              Вернуться к покупкам
            </Link>
          </div>
          <aside className={s.summary}>
            <h2>Ваш заказ</h2>
            <div>
              <span>Товары · {count} шт.</span>
              <b>{money(total)}</b>
            </div>
            <div>
              <span>Доставка СДЭК</span>
              <span>На следующем шаге</span>
            </div>
            <div className={s.total}>
              <span>Итого</span>
              <strong>{money(total)}</strong>
            </div>
            <Link to="/checkout" className="button">
              Перейти к оформлению
            </Link>
            <p className={s.summaryNote}>
              <Truck size={16} /> Выберем удобный способ доставки
              <br />и покажем полную стоимость.
            </p>
            <p className={s.privacyNote}>
              Демонстрационный заказ. Реальные платежи и сбор персональных
              данных отключены.
            </p>
          </aside>
        </div>
      )}
    </div>
  );
}
