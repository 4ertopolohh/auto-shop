        again=self.post('checkout/',self.payload)
        self.assertEqual(r.json()['id'],again.json()['id']);self.assertEqual(Order.objects.count(),1)
        order=Order.objects.get();self.assertEqual(order.phone,'+7 (000) 000-00-00')
